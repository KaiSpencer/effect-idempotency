{
  "name": "effect-idempotency",
  "version": "0.0.1",
  "description": "Idempotency-Key handling for Effect's HttpApi: server and client middleware. In development.",
  "license": "MIT",
  "author": "KaiSpencer",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.4.5-canary.20261126.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaiSpencer/effect-idempotency.git"
  },
  "homepage": "https://github.com/KaiSpencer/effect-idempotency#readme",
  "bugs": {
    "url": "https://github.com/KaiSpencer/effect-idempotency/issues"
  },
  "keywords": [
    "effect",
    "effect-ts",
    "idempotency",
    "idempotency-key",
    "httpapi",
    "middleware"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "lib": [
      "es2022"
    ]
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --dts --packages external --target node --sourcemap=linked --outdir dist",
    "verify": "bun fmt --check && bun lint && bun check && bun check -p tsconfig.src.json && bun test",
    "repos:sync": "bun scripts/sync-repos.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun scripts/release.ts",
    "stage": "bun scripts/stage/main.ts",
    "prepublishOnly": "bun run build",
    "prepare": "bun scripts/sync-repos.ts"
  },
  "peerDependencies": {
    "effect": "^4.1.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@effect/platform-bun": "^4.1.5",
    "@effect/sql-pg": "^4.1.5",
    "@effect/sql-pglite": "^4.1.5",
    "@effect/sql-sqlite-bun": "^4.1.5",
    "@types/bun": "^1.4.5",
    "effect": "^4.1.5"
  }
}
